; Engine configuration file.
; Triple Threat Arena — Godot 4.6 game.

config_version=5

[application]

config/name="Triple Threat Arena"
config/description="Satirische 3-Kämpfer-Arena. Letzter Stehender gewinnt."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

